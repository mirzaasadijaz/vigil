# Copy this file to `.env` and edit for the target machine:
#     cp .env.example .env
#
# `.env` is git-ignored, so every machine needs its own copy.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL via the asyncpg driver. Create the DB/user first (see SETUP.md).
DATABASE_URL=postgresql+asyncpg://postgres:admin@127.0.0.1:5432/ppe_new

# ── Auth / JWT ──────────────────────────────────────────────────────────────
# Generate a fresh secret per deployment:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Paths (MUST be absolute paths on THIS machine) ──────────────────────────
# BASE_DIR is the repo root; MEDIA_ROOT holds snapshots + employee photos.
MEDIA_ROOT=/absolute/path/to/PPE_NEW/media
BASE_DIR=/absolute/path/to/PPE_NEW

# ── Chatbot ──────────────────────────────────────────────
# Key from https://aistudio.google.com/apikey  (GOOGLE_API_KEY also works as a name)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional RAG tuning
RAG_EMBED_MODEL=default
RAG_TOP_K=4
RAG_MIN_SCORE=0.2
RAG_IMAGE_MIN_SCORE=0.0

# ── LangSmith / Observability ───────────────────────────────────────────────
# Get your API key from https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ppe_new
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com